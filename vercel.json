{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/__/auth/:path*/",
      "destination": "/__/auth/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://yflb-atlas-content-261103.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist"
}
